# git internals
.git/
.gitignore

# wrangler local cache/state (contains account metadata)
.wrangler/

# wrangler config + this ignore file
wrangler.jsonc
.assetsignore

# python dev-time helpers (compress/fix_board scripts)
*.py

# D1 schema (DB setup, not runtime)
schema.sql

# Worker source (bundled by wrangler, don't ship as static asset)
worker/

# node_modules if it ever appears
node_modules/
